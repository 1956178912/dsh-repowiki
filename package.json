{
  "name": "dsh-repowiki",
  "version": "0.27.0",
  "private": true,
  "description": "Symbol-level repository knowledge index, knowledge cards, wiki synthesis and cross-session query for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "verify:host": "node scripts/verify-host-tokens.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/detail",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
