{
  "name": "dsh-repowiki",
  "version": "0.193.0",
  "private": true,
  "description": "Symbol-level repository knowledge index, task context packs, impact analysis, cards and wiki for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "coverage:check": "node scripts/check-coverage.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "lint": "eslint index.js src client.js scripts test",
    "bench": "node scripts/bench.mjs",
    "release": "node scripts/release.mjs",
    "verify:host": "node scripts/verify-host-tokens.mjs",
    "verify:wiki": "node scripts/verify-wiki.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/detail",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2"
  }
}
